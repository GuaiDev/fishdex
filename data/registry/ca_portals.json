    "adapted": "a catalogue was found, holds fish data, and an adapter exists",
    "catalogue_found": "machine-readable catalogue responds; not yet adapted",
    "needs_probe": "website known, catalogue not yet located — harvester will try",
    "needs_url": "no website recorded; cannot be probed until one is added"
  },
