{
  "buildCommand": "sh scripts/build_vercel.sh",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/app/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/app/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
